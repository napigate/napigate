CURRENT_USER=
CURRENT_GROUP=

UID=1000
GID=1000

NAPIGATE_IMAGE=napigate/napigate:latest
NAPIGATE_PULL_POLICY=missing
NAPIGATE_IMAGE_USER=app
NAPIGATE_IMAGE_GROUP=app
NAPIGATE_IMAGE_UID=1000
NAPIGATE_IMAGE_GID=1000

APP_PORT=8000
ADMIN_PORT=8001
APP_TIMEZONE=Asia/Tehran
NAPIGATE_CONFIG=config/services.yaml
NAPIGATE_SECURITY_CONFIG=config/security.yaml
# State store: file or postgres.
NAPIGATE_STATE_STORE=file
# Example:
# NAPIGATE_POSTGRES_DSN=postgresql://napigate:napigate@postgres:5432/napigate
NAPIGATE_POSTGRES_DSN=
# How often other instances check for config/security revision changes in Postgres.
NAPIGATE_STATE_SYNC_INTERVAL_SECONDS=2
NAPIGATE_ADMIN_USERNAME=admin
NAPIGATE_ADMIN_PASSWORD=change-me
# Empty means allow admin UI and admin API access from anywhere.
# Use comma-separated IPs or CIDRs to restrict `/__admin`, for example:
# NAPIGATE_ADMIN_ACCESS_WHITELIST_IPS=127.0.0.1/32,10.0.0.0/24
NAPIGATE_ADMIN_ACCESS_WHITELIST_IPS=
# Redis URL for distributed rate limiting and response caching.
# Leave empty to use in-memory backends (single-instance only).
# Example: redis://localhost:6379/0  or  redis://:password@redis-host:6379/0
NAPIGATE_REDIS_URL=
# Maximum number of concurrent request-handling threads (includes long-lived SSE connections).
NAPIGATE_MAX_WORKERS=256

# Optional Postgres profile defaults for docker compose --profile postgres
POSTGRES_DB=napigate
POSTGRES_USER=napigate
POSTGRES_PASSWORD=napigate

# Package mirrors (optional)
# Leave these as global defaults unless you explicitly want a regional mirror.
DEBIAN_MIRROR_URL=https://deb.debian.org/debian
DEBIAN_SECURITY_MIRROR_URL=https://security.debian.org/debian-security
PIP_INDEX_URL=https://pypi.org/simple
